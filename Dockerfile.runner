# CXE persistent NsJail runner (plain Java, no Spring/Kubernetes client).
# Build: docker build -f Dockerfile.runner -t hrishabhjoshi/cxe-nsjail-runner:local .

ARG NSJAIL_VERSION=3.6
ARG BUILD_DATE=unknown
ARG VCS_REF=unknown

FROM eclipse-temurin:21-jdk-jammy AS nsjail-build
ARG NSJAIL_VERSION
RUN apt-get update \
    && DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends \
        autoconf bison flex g++ gcc git libnl-route-3-dev libprotobuf-dev \
        libtool make pkg-config protobuf-compiler \
    && git clone --depth 1 --branch "${NSJAIL_VERSION}" https://github.com/google/nsjail.git /src/nsjail \
    && make -C /src/nsjail \
    && test -x /src/nsjail/nsjail

FROM eclipse-temurin:21-jdk-jammy AS app-build
WORKDIR /app

COPY gradlew gradlew.bat build.gradle settings.gradle ./
COPY gradle ./gradle
RUN chmod +x gradlew

COPY execution-core ./execution-core
COPY nsjail-runner ./nsjail-runner

RUN ./gradlew :nsjail-runner:installDist -x test --no-daemon

FROM eclipse-temurin:21-jre-jammy AS runtime
ARG BUILD_DATE
ARG VCS_REF
ARG NSJAIL_VERSION

LABEL org.opencontainers.image.title="cxe-nsjail-runner" \
      org.opencontainers.image.description="AlgoCrack persistent NsJail execution runner" \
      org.opencontainers.image.version="${NSJAIL_VERSION}" \
      org.opencontainers.image.created="${BUILD_DATE}" \
      org.opencontainers.image.revision="${VCS_REF}" \
      xyz.hrishabhjoshi.cxe.component="nsjail-runner" \
      xyz.hrishabhjoshi.cxe.nsjail.version="${NSJAIL_VERSION}"

RUN apt-get update \
    && DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends \
        python3 libnl-route-3-200 libprotobuf23 procps \
    && rm -rf /var/lib/apt/lists/* \
    && groupadd --gid 10001 runner \
    && useradd --uid 10001 --gid 10001 --create-home --shell /usr/sbin/nologin runner \
    && mkdir -p /workspace /quarantine /opt/cxe-runner/lib \
    && chown -R runner:runner /workspace /quarantine

COPY --from=nsjail-build /src/nsjail/nsjail /usr/local/bin/nsjail
COPY --from=app-build /app/nsjail-runner/build/install/nsjail-runner /opt/cxe-runner
COPY docker/runner-entrypoint.sh docker/runner-probe.sh /usr/local/bin/
RUN chmod 0555 /usr/local/bin/nsjail /usr/local/bin/runner-entrypoint.sh /usr/local/bin/runner-probe.sh \
    && chown -R runner:runner /opt/cxe-runner

ENV CXE_NSJAIL_BIN=/usr/local/bin/nsjail \
    CXE_RUNNER_WORKSPACE_ROOT=/workspace \
    CXE_RUNNER_QUARANTINE_ROOT=/quarantine \
    EXECUTION_EXTRA_CLASSPATH=/opt/cxe-runner/lib/*

USER 10001:10001
WORKDIR /opt/cxe-runner

ENTRYPOINT ["/usr/local/bin/runner-entrypoint.sh"]
