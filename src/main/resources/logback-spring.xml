<?xml version="1.0" encoding="UTF-8"?>
<configuration>
    <springProperty scope="context" name="appName" source="spring.application.name" defaultValue="code-execution-service"/>
    <springProperty scope="context" name="env" source="spring.profiles.active" defaultValue="local"/>

    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder class="net.logstash.logback.encoder.LogstashEncoder">
            <customFields>{"service":"${appName}","environment":"${env}","kube_micro":"CodeExecutionEngine"}</customFields>
            <includeMdcKeyName>request_id</includeMdcKeyName>
        </encoder>
    </appender>

    <root level="INFO">
        <appender-ref ref="CONSOLE"/>
    </root>

    <logger name="xyz.hrishabhjoshi.codeexecutionengine" level="${LOG_LEVEL_CXE:INFO}"/>
    <logger name="org.springframework.data.redis" level="WARN"/>
    <logger name="io.lettuce" level="WARN"/>
</configuration>
